{
  "name": "yanqian-todo-list",
  "productName": "眼前",
  "version": "0.2.5",
  "private": true,
  "author": "Yanqian",
  "description": "眼前：轻量、常驻的桌面待办",
  "scripts": {
    "serve": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js serve",
    "build": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js build",
    "lint": "eslint src --ext .js,.vue --fix",
    "electron:build": "node --openssl-legacy-provider --require ./scripts/nsis-utf8.cjs node_modules/@vue/cli-service/bin/vue-cli-service.js electron:build",
    "electron:serve": "node --openssl-legacy-provider node_modules/@vue/cli-service/bin/vue-cli-service.js electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test": "node --test tests/*.test.cjs",
    "lint:check": "eslint src --ext .js,.vue",
    "check:compile": "node --openssl-legacy-provider scripts/compile-check.cjs",
    "check:native": "node scripts/run-native-smoke.cjs"
  },
  "main": "background.js",
  "dependencies": {
    "core-js": "^3.6.5",
    "dayjs": "^1.9.6",
    "electron-updater": "^4.3.5",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.2.0",
    "fs-extra": "^9.0.1",
    "lodash-id": "^0.14.0",
    "lowdb": "^1.0.0",
    "vue": "^2.6.11",
    "vue-router": "^3.2.0",
    "vuedraggable": "^2.24.3",
    "vuex": "^3.4.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-plugin-router": "~4.5.0",
    "@vue/cli-plugin-vuex": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/test-utils": "1.3.6",
    "babel-eslint": "^10.1.0",
    "electron": "^11.0.0",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^6.7.2",
    "eslint-plugin-prettier": "^3.1.3",
    "eslint-plugin-vue": "^6.2.2",
    "jsdom": "22.1.0",
    "prettier": "^1.19.1",
    "sass": "^1.26.5",
    "sass-loader": "^8.0.2",
    "vue-cli-plugin-electron-builder": "~2.0.0-rc.5",
    "vue-template-compiler": "^2.6.11",
    "electron-builder": "^22.10.5"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "websocket-driver": "0.7.4"
  }
}
